#!/usr/bin/env python3
"""Local CLI wrapper: Drift-sweep worklist - the N oldest knowledge articles by updated: date.

Implementation lives in actions/drift-check/sweep_report.py (co-located with
the shared frontmatter parser). Run with --help for usage.
"""

from __future__ import annotations

import sys
from pathlib import Path


def _find_repo_root(start: Path) -> Path:
    here = start.resolve()
    while True:
        if (here / "actions" / "drift-check" / "sweep_report.py").exists():
            return here
        if here.parent == here:
            break
        here = here.parent
    raise SystemExit(
        "sweep-report: could not locate actions/drift-check/sweep_report.py "
        "by walking up from this script."
    )


def main() -> int:
    here = Path(__file__).resolve()
    repo_root = _find_repo_root(here)
    sys.path.insert(0, str(repo_root / "actions" / "drift-check"))
    import sweep_report  # noqa: E402
    return sweep_report.cli_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
