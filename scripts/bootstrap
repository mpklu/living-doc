#!/usr/bin/env python3
"""Local CLI wrapper: Regenerate knowledge/manifest.md (the entry point) from article frontmatter.

Implementation lives in actions/drift-check/bootstrap.py (co-located with
the shared frontmatter parser). Run with --help for usage.
"""

from __future__ import annotations

import sys
from pathlib import Path


def _find_repo_root(start: Path) -> Path:
    here = start.resolve()
    while True:
        if (here / "actions" / "drift-check" / "bootstrap.py").exists():
            return here
        if here.parent == here:
            break
        here = here.parent
    raise SystemExit(
        "bootstrap: could not locate actions/drift-check/bootstrap.py "
        "by walking up from this script."
    )


def main() -> int:
    here = Path(__file__).resolve()
    repo_root = _find_repo_root(here)
    sys.path.insert(0, str(repo_root / "actions" / "drift-check"))
    import bootstrap  # noqa: E402
    return bootstrap.cli_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
