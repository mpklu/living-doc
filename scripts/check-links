#!/usr/bin/env python3
"""Local CLI wrapper: Verify [[wikilinks]] and relative markdown links in knowledge/ resolve.

Implementation lives in actions/drift-check/check_links.py (co-located with
the shared frontmatter parser). Run with --help for usage.
"""

from __future__ import annotations

import sys
from pathlib import Path


def _find_repo_root(start: Path) -> Path:
    here = start.resolve()
    while True:
        if (here / "actions" / "drift-check" / "check_links.py").exists():
            return here
        if here.parent == here:
            break
        here = here.parent
    raise SystemExit(
        "check-links: could not locate actions/drift-check/check_links.py "
        "by walking up from this script."
    )


def main() -> int:
    here = Path(__file__).resolve()
    repo_root = _find_repo_root(here)
    sys.path.insert(0, str(repo_root / "actions" / "drift-check"))
    import check_links  # noqa: E402
    return check_links.cli_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
