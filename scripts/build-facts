#!/usr/bin/env python3
"""Local CLI wrapper: generate knowledge/facts/<area>.md from articles' ## Facts sections.

Implementation lives in actions/drift-check/build_facts.py (co-located with
the shared frontmatter parser). Run with --help for usage.
"""

from __future__ import annotations

import sys
from pathlib import Path


def _find_repo_root(start: Path) -> Path:
    here = start.resolve()
    while True:
        if (here / "actions" / "drift-check" / "build_facts.py").exists():
            return here
        if here.parent == here:
            break
        here = here.parent
    raise SystemExit(
        "build-facts: could not locate actions/drift-check/build_facts.py "
        "by walking up from this script."
    )


def main() -> int:
    here = Path(__file__).resolve()
    repo_root = _find_repo_root(here)
    sys.path.insert(0, str(repo_root / "actions" / "drift-check"))
    import build_facts  # noqa: E402
    return build_facts.cli_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
