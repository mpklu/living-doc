#!/usr/bin/env python3
"""Local CLI wrapper: cross-repo Knowledge: trailer check for product repos.

Implementation lives in actions/drift-check/check_trailer.py (co-located
with the shared parser + matcher). Run with --help for usage; typically
installed into a product repo via:
    <knowledge-repo>/scripts/check-trailer --install --knowledge-repo <knowledge-repo>
"""

from __future__ import annotations

import sys
from pathlib import Path


def _find_repo_root(start: Path) -> Path:
    here = start.resolve()
    while True:
        if (here / "actions" / "drift-check" / "check_trailer.py").exists():
            return here
        if here.parent == here:
            break
        here = here.parent
    raise SystemExit(
        "check-trailer: could not locate actions/drift-check/check_trailer.py "
        "by walking up from this script."
    )


def main() -> int:
    here = Path(__file__).resolve()
    repo_root = _find_repo_root(here)
    sys.path.insert(0, str(repo_root / "actions" / "drift-check"))
    import check_trailer  # noqa: E402
    return check_trailer.cli_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
