#!/usr/bin/env python3
"""Local CLI wrapper: One-screen knowledge-base status (SessionStart hook).

Implementation lives in actions/drift-check/kb_status.py (co-located with
the shared frontmatter parser). Run with --help for usage.
"""

from __future__ import annotations

import sys
from pathlib import Path


def _find_repo_root(start: Path) -> Path:
    here = start.resolve()
    while True:
        if (here / "actions" / "drift-check" / "kb_status.py").exists():
            return here
        if here.parent == here:
            break
        here = here.parent
    raise SystemExit(
        "kb-status: could not locate actions/drift-check/kb_status.py "
        "by walking up from this script."
    )


def main() -> int:
    here = Path(__file__).resolve()
    repo_root = _find_repo_root(here)
    sys.path.insert(0, str(repo_root / "actions" / "drift-check"))
    import kb_status  # noqa: E402
    return kb_status.cli_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
